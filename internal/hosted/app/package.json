{
  "name": "@gog/hosted-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "design:generate": "node ../../../scripts/generate-hosted-design.mjs",
    "design:check": "node ../../../scripts/generate-hosted-design.mjs --check",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm format:check && oxlint --deny-warnings .",
    "typecheck": "tsc6 -p tsconfig.json --noEmit && tsc6 -p tsconfig.chat.json --noEmit",
    "test": "vitest run",
    "build": "tsc6 -p tsconfig.json --noEmit && tsc6 -p tsconfig.chat.json --noEmit && vite build",
    "dev": "pnpm build && wrangler dev"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.141",
    "@assistant-ui/ai-sdk": "0.0.12",
    "@assistant-ui/react": "0.15.28",
    "@assistant-ui/react-markdown": "0.14.21",
    "@cloudflare/ai-chat": "0.12.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "agents": "0.28.0",
    "ai": "7.0.138",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@clerk/backend": "3.22.0",
    "@cloudflare/workers-types": "5.20261012.1",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20260918.0-alpha",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.1",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@11.27.1"
}
